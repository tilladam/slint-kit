import { KitStyle, CopyButton, CodeBlock, CodeLine, CommandPalette, PaletteRow } from "@slint-widgets";
import { Button, Palette } from "std-widgets.slint";

export { KitStyle }

export component Gallery inherits Window {
    title: "slint-widgets gallery";
    default-font-family: "SF Pro";
    preferred-width: 640px;
    preferred-height: 460px;
    background: Palette.background;

    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    in property <string> code;
    in property <[CodeLine]> code-lines;
    in property <color> code-background;
    // What the last copy or palette run did.
    in-out property <string> status;
    in-out property <bool> palette-visible;
    in property <[PaletteRow]> palette-entries;
    callback palette-query(string);
    callback palette-exec(string);

    // "light" or "dark" forces Palette's colour scheme. A function, not a
    // `changed` handler: those run later, so `dark` would still be stale
    // when Rust reads it right after.
    public function force-scheme(scheme: string) {
        if (scheme == "dark") {
            Palette.color-scheme = ColorScheme.dark;
        } else if (scheme == "light") {
            Palette.color-scheme = ColorScheme.light;
        }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "CopyButton";
                color: Palette.foreground;
                vertical-alignment: center;
            }
            CopyButton {
                payload: "copied text";
                copy-requested(t) => { root.status = "copied: " + t; }
            }
            Text {
                text: root.status;
                color: KitStyle.dim;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Button {
                text: "Command palette";
                clicked => { root.palette-visible = true; }
            }
        }
        CodeBlock {
            lang: "rust";
            code: root.code;
            lines: root.code-lines;
            code-background: root.code-background;
            copy-requested(t) => { root.status = "copied " + t.character-count + " characters of code"; }
        }
    }

    if root.palette-visible: CommandPalette {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        entries: root.palette-entries;
        placeholder-text: "Type a command, session, or action…";
        close-shortcut-key: "p";
        close => { root.palette-visible = false; }
        query-changed(q) => { root.palette-query(q); }
        exec(id) => {
            root.palette-visible = false;
            root.palette-exec(id);
        }
    }
}
