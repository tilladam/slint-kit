import { KitStyle, CopyButton, CodeBlock, CodeLine, CommandPalette, PaletteRow,
    ProseBlock, HeadingBlock, QuoteBlock, RuleBlock, TableBlock, TableRowCells } from "@slint-widgets";
import { Button, Palette } from "std-widgets.slint";

export { KitStyle }

export component Gallery inherits Window {
    title: "slint-widgets gallery";
    default-font-family: "SF Pro";
    preferred-width: 640px;
    preferred-height: root.page == "markdown" ? 760px : 460px;
    background: Palette.background;

    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    in property <string> code;
    in property <[CodeLine]> code-lines;
    in property <color> code-background;
    // What the last copy or palette run did.
    in-out property <string> status;
    in-out property <bool> palette-visible;
    in property <[PaletteRow]> palette-entries;
    // "markdown" shows the markdown blocks; anything else the widgets page.
    in property <string> page;
    in property <string> heading;
    in property <int> heading-level: 1;
    in property <styled-text> prose;
    in property <string> prose-raw;
    in property <styled-text> quote;
    in property <[TableRowCells]> table3;
    in property <length> table3-width;
    in property <[TableRowCells]> table6;
    in property <length> table6-width;
    callback palette-query(string);
    callback palette-exec(string);

    // "light" or "dark" forces Palette's colour scheme. A function, not a
    // `changed` handler: those run later, so `dark` would still be stale
    // when Rust reads it right after.
    public function force-scheme(scheme: string) {
        if (scheme == "dark") {
            Palette.color-scheme = ColorScheme.dark;
        } else if (scheme == "light") {
            Palette.color-scheme = ColorScheme.light;
        }
    }

    if root.page == "markdown": VerticalLayout {
        padding: 20px;
        spacing: 8px;
        alignment: start;
        HeadingBlock {
            text: root.heading;
            level: root.heading-level;
            copy-payload: root.prose-raw;
            copy-requested(t) => { root.status = "copied " + t.character-count + " characters"; }
        }
        ProseBlock {
            text: root.prose;
            open-link(l) => { root.status = "link " + l; }
        }
        QuoteBlock { text: root.quote; }
        RuleBlock { }
        HorizontalLayout {
            TableBlock {
                horizontal-stretch: 0;
                width: min(parent.width, root.table3-width);
                rows: root.table3;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            TableBlock {
                horizontal-stretch: 0;
                width: min(parent.width, root.table6-width);
                rows: root.table6;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.status;
            color: KitStyle.dim;
        }
    }

    if root.page != "markdown": VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "CopyButton";
                color: Palette.foreground;
                vertical-alignment: center;
            }
            CopyButton {
                payload: "copied text";
                copy-requested(t) => { root.status = "copied: " + t; }
            }
            Text {
                text: root.status;
                color: KitStyle.dim;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Button {
                text: "Command palette";
                clicked => { root.palette-visible = true; }
            }
        }
        CodeBlock {
            lang: "rust";
            code: root.code;
            lines: root.code-lines;
            code-background: root.code-background;
            copy-requested(t) => { root.status = "copied " + t.character-count + " characters of code"; }
        }
    }

    if root.palette-visible: CommandPalette {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        entries: root.palette-entries;
        placeholder-text: "Type a command, session, or action…";
        close-shortcut-key: "p";
        close => { root.palette-visible = false; }
        query-changed(q) => { root.palette-query(q); }
        exec(id) => {
            root.palette-visible = false;
            root.palette-exec(id);
        }
    }
}
