import { KitStyle } from "style.slint";

// A small "copy" button: emits copy-requested(payload) and shows a check
// mark for 1.4 s. Copying itself (the clipboard) is the app's job.
export component CopyButton inherits Rectangle {
    in property <string> payload;
    callback copy-requested(string);
    property <bool> copied: false;

    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: "Copy";
    accessible-action-default => { root.copy(); }
    border-width: keyboard.has-focus ? 1px : 0px;
    border-color: KitStyle.accent;

    function copy() {
        keyboard.focus();
        root.copy-requested(root.payload);
        root.copied = true;
        reset.running = false;
        reset.running = true;
    }

    keyboard := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.copy();
                return accept;
            }
            reject
        }
    }

    width: 34px;
    height: 20px;
    border-radius: 5px;
    background: touch.has-hover ? KitStyle.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.copy();
        }
    }
    Text {
        text: root.copied ? "✓" : "copy";
        font-size: 10px;
        color: root.copied ? KitStyle.accent : KitStyle.dim;
    }
    reset := Timer {
        interval: 1400ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}
