import { ListView, LineEdit, Palette } from "std-widgets.slint";

// One palette entry. `icon` is a short glyph or symbol shown before the
// label (pick ones that render in your fonts; see slinty-pi's bummer.md on
// symbols that draw as empty boxes).
export struct PaletteRow {
    id: string,
    icon: string,
    label: string,
    detail: string,
}

// A modal command palette: dimmed backdrop, query field, ranked list. The
// app ranks: it gets query-changed(text) and sets `entries`; exec(id) runs
// an entry; close() asks the app to hide the palette.
//
// Owns its selection and keyboard navigation through an internal
// FocusScope: the query field takes focus on open, which moves focus out of
// any FocusScope in the app's own tree, so the app can't drive these keys.
export component CommandPalette inherits Rectangle {
    in property <[PaletteRow]> entries: [];
    in property <string> placeholder-text: "Type a command…";
    // Cmd+<this key> closes the palette too (e.g. "p" when Cmd+P opens it);
    // empty: only Esc closes.
    in property <string> close-shortcut-key;
    property <int> selected: 0;
    callback query-changed(string);
    callback exec(string);
    callback close();

    background: Palette.background.transparentize(0.1);

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(560px, parent.width - 48px);
        height: min(460px, parent.height - 48px);
        background: Palette.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.border.transparentize(0.4);
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;

        TouchArea {}

        FocusScope {
            // Up/Down/Enter/Esc (and the close shortcut) are ours; everything
            // else (typing) falls through to the query field.
            capture-key-pressed(event) => {
                if (root.close-shortcut-key != "" && event.modifiers.meta
                    && event.text == root.close-shortcut-key) {
                    root.close();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.entries.length > 0) {
                        root.selected = min(root.entries.length - 1, root.selected + 1);
                    }
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.entries.length > 0) {
                        root.selected = max(0, root.selected - 1);
                    }
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.selected >= 0 && root.selected < root.entries.length) {
                        root.exec(root.entries[root.selected].id);
                    }
                    return accept;
                }
                reject
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                query := LineEdit {
                    placeholder-text: root.placeholder-text;
                    edited(text) => {
                        root.selected = 0;
                        root.query-changed(text);
                    }
                    init => { self.focus(); }
                }

                if root.entries.length == 0: Text {
                    text: "No matches.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.5);
                }

                ListView {
                    for row[i] in root.entries: Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        background: i == root.selected ? Palette.accent-background.transparentize(0.85) : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: row.icon;
                                font-size: 11px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.label;
                                font-size: 12.5px;
                                color: Palette.foreground;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if row.detail != "": Text {
                                text: row.detail;
                                font-size: 11px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.selected = i;
                                root.exec(row.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
